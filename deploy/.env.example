# Copy to /opt/vibecade/deploy/.env on the droplet (setup-droplet.sh does this for you).
# Docker Compose reads it, and the web container gets it as its environment.

# The domain Caddy serves and gets certificates for; www.<domain> redirects here.
SITE_DOMAIN=vibecade.si

# Image to run. The GitHub deploy workflow sets this on every deploy; leave the default
# when you build on the droplet with `docker compose build web`.
# VIBECADE_IMAGE=ghcr.io/<owner>/<repo>:latest

# --- Build-time (inlined into the browser bundle; only used by `docker compose build`).
# The GitHub workflow takes these from repository variables instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_X_PROVIDER=

# --- Runtime, server-only (never NEXT_PUBLIC_).
# Grok-powered "Trending" memes in Meme Duel (optional).
XAI_API_KEY=
# TRENDING_MEMES_REFRESH_HOURS=6
